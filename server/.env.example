# ─────────────────────────────────────────────────────────────────
# FindIt Backend — Local Development
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────

# ── Google Gemini ─────────────────────────────────────────────────
# Get your API key from https://aistudio.google.com/
GOOGLE_API_KEY=<your-gemini-api-key>

# ── Azure Blob Storage ────────────────────────────────────────────
# The storage account URL where videos and indexes are stored.
# Retrieve from Azure: az containerapp show --name app-memory-backend --resource-group rg-memory-assistant --query "properties.template.containers[0].env[?name=='AZURE_STORAGE_ACCOUNT_URL'].value" -o tsv
AZURE_STORAGE_ACCOUNT_URL=https://<your-storage-account>.blob.core.windows.net
