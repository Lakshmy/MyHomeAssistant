# ─────────────────────────────────────────────────────────────────
# Memory Assistant Backend (v2 — Azure OpenAI / GPT-5.2)
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────

# ── Azure OpenAI / MS Foundry ──────────────────────────────────────
# Auth uses Managed Identity (production) or 'az login' (local dev).
AZURE_OPENAI_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-5.2

# ── Azure Blob Storage ────────────────────────────────────────────
AZURE_STORAGE_ACCOUNT_URL=https://<your-storage-account>.blob.core.windows.net
